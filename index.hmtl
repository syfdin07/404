<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nyari apa dek ?</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #09090b;
      color: #fafafa;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
    }

    /* Subtle cursor glow spotlight */
    .glow {
      position: fixed;
      width: 480px;
      height: 480px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.07) 0%, transparent 65%);
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    /* Smooth letter hover tease */
    .tease-char {
      display: inline-block;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.25s ease;
    }
    .tease-char:hover {
      transform: translateY(-8px) scale(1.12);
      color: #f59e0b;
    }

    /* Tilting question mark */
    .question-mark {
      display: inline-block;
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .question-mark:hover {
      transform: rotate(20deg) scale(1.2);
      color: #fbbf24;
    }

    /* Minimal teasing pop text on click */
    .whisper-ping {
      position: fixed;
      pointer-events: none;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      color: #f59e0b;
      opacity: 1;
      transform: translateY(0);
      animation: pingFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      z-index: 50;
    }

    @keyframes pingFade {
      0% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.8);
      }
      20% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
      100% {
        opacity: 0;
        transform: translate(-50%, -85px) scale(0.95);
      }
    }
  </style>
</head>

<body class="min-h-screen flex flex-col items-center justify-center p-6 relative">

  <!-- Ambient Light Follower -->
  <div id="glow" class="glow"></div>

  <!-- Main Minimal Stage -->
  <main class="relative z-10 flex flex-col items-center text-center max-w-lg w-full">

    <!-- Minimal Pair of Watching Eyes -->
    <div id="eye-container" class="flex gap-4 mb-8 opacity-80 transition-transform duration-300 hover:scale-110">
      <!-- Left Eye -->
      <div class="w-9 h-9 rounded-full border border-zinc-700 bg-zinc-900/90 flex items-center justify-center relative shadow-inner">
        <div id="pupil-left" class="w-3 h-3 rounded-full bg-zinc-200 transition-transform duration-75"></div>
      </div>
      <!-- Right Eye -->
      <div class="w-9 h-9 rounded-full border border-zinc-700 bg-zinc-900/90 flex items-center justify-center relative shadow-inner">
        <div id="pupil-right" class="w-3 h-3 rounded-full bg-zinc-200 transition-transform duration-75"></div>
      </div>
    </div>

    <!-- The Singular Headline -->
    <h1 class="text-4xl sm:text-6xl font-semibold tracking-tight text-zinc-100 select-none mb-8">
      <span class="inline-block">
        <span class="tease-char">N</span><span class="tease-char">y</span><span class="tease-char">a</span><span class="tease-char">r</span><span class="tease-char">i</span>
      </span>
      <span class="inline-block mx-2 text-zinc-400 font-light">
        <span class="tease-char">a</span><span class="tease-char">p</span><span class="tease-char">a</span>
      </span>
      <span class="inline-block">
        <span class="tease-char">d</span><span class="tease-char">e</span><span class="tease-char">k</span>
      </span>
      <span class="question-mark ml-1 text-amber-400">?</span>
    </h1>

    <!-- Minimal Elusive Search Bar -->
    <div class="relative w-full max-w-sm">
      <div class="relative flex items-center bg-zinc-900/70 border border-zinc-800 rounded-full px-4 py-2.5 backdrop-blur-md transition-all duration-300 focus-within:border-zinc-600 focus-within:ring-1 focus-within:ring-amber-400/20 shadow-lg">
        
        <!-- Subtle Search Icon -->
        <svg class="w-4 h-4 text-zinc-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7" stroke-width="2" stroke-linecap="round"></circle>
          <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round"></path>
        </svg>

        <!-- Search Input with Playful Auto-Reject -->
        <input 
          id="search-input" 
          type="text" 
          placeholder="Cari sesuatu..." 
          autocomplete="off"
          class="bg-transparent text-sm w-full text-zinc-200 placeholder:text-zinc-600 focus:outline-none"
        />

        <!-- Teasing Interactive Action Button -->
        <button 
          id="tease-btn"
          aria-label="Cari"
          class="ml-2 w-7 h-7 rounded-full bg-zinc-800 hover:bg-zinc-700 flex items-center justify-center text-zinc-300 text-xs transition-all duration-200 flex-shrink-0 hover:text-amber-400"
        >
          &rarr;
        </button>
      </div>

      <!-- Ephemeral Status Notice -->
      <p id="status-hint" class="text-xs text-zinc-500 mt-3 h-4 tracking-wide font-light transition-opacity duration-300 opacity-0">
        Kosong, dek.
      </p>
    </div>

  </main>

  <script>
    // Audio synthesis for subtle elegant click
    let audioCtx = null;
    function playSoftBeep(pitch = 580) {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.frequency.setValueAtTime(pitch, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.15);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.15);
      } catch(e) {}
    }

    // Smooth eye pupil tracking & mouse spotlight
    const glow = document.getElementById('glow');
    const eyeContainer = document.getElementById('eye-container');
    const pupilLeft = document.getElementById('pupil-left');
    const pupilRight = document.getElementById('pupil-right');

    function updatePupils(e) {
      const x = e.clientX || (e.touches && e.touches[0].clientX);
      const y = e.clientY || (e.touches && e.touches[0].clientY);

      if (glow && x && y) {
        glow.style.left = `${x}px`;
        glow.style.top = `${y}px`;
      }

      if (eyeContainer && pupilLeft && pupilRight && x && y) {
        const rect = eyeContainer.getBoundingClientRect();
        const eyeCenterX = rect.left + rect.width / 2;
        const eyeCenterY = rect.top + rect.height / 2;

        const deltaX = x - eyeCenterX;
        const deltaY = y - eyeCenterY;
        const distance = Math.min(5, Math.hypot(deltaX, deltaY) / 25);
        const angle = Math.atan2(deltaY, deltaX);

        const offsetX = Math.cos(angle) * distance;
        const offsetY = Math.sin(angle) * distance;

        pupilLeft.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
        pupilRight.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      }
    }

    window.addEventListener('mousemove', updatePupils);
    window.addEventListener('touchmove', updatePupils, { passive: true });

    // Interactive Search Input: playfully denies searching
    const input = document.getElementById('search-input');
    const teaseBtn = document.getElementById('tease-btn');
    const statusHint = document.getElementById('status-hint');

    const evasivePhrases = [
      "Nggak ada apa-apa di sini.",
      "Cari di tempat lain, dek.",
      "Masih dicari juga?",
      "Yakin nemu?",
      "Salah alamat.",
      "Udah dibilang kosong."
    ];

    let phraseIndex = 0;

    function triggerTease() {
      playSoftBeep(420);
      statusHint.textContent = evasivePhrases[phraseIndex % evasivePhrases.length];
      statusHint.classList.remove('opacity-0');
      phraseIndex++;

      // Playful wiggle on input
      input.classList.add('translate-x-1');
      setTimeout(() => input.classList.remove('translate-x-1'), 150);

      // Auto clear input after slight delay
      setTimeout(() => {
        input.value = '';
      }, 700);
    }

    teaseBtn.addEventListener('click', triggerTease);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        triggerTease();
      }
    });

    // Tap anywhere floating subtle response
    const quickWhispers = ["dek?", "kosong", "nyari apa?", "gapapa"];
    window.addEventListener('click', (e) => {
      if (e.target.closest('#search-input') || e.target.closest('#tease-btn')) return;

      playSoftBeep(750 + Math.random() * 200);

      const ping = document.createElement('span');
      ping.className = 'whisper-ping';
      ping.textContent = quickWhispers[Math.floor(Math.random() * quickWhispers.length)];
      ping.style.left = `${e.clientX}px`;
      ping.style.top = `${e.clientY}px`;

      document.body.appendChild(ping);
      setTimeout(() => ping.remove(), 1200);
    });
  </script>
</body>
</html>
